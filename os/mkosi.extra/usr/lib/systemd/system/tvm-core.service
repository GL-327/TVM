[Unit]
Description=TVM core (local media service)
Documentation=https://github.com/GL-327/TVM
After=network-online.target
Wants=network-online.target
Before=tvm-session.service

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/lib/tvm/core/index.js
Environment=NODE_ENV=production
Environment=TVM_UI_DIST=/usr/lib/tvm/ui
User=tvm
Group=tvm

# /var/lib/tvm is the persistent data root from the storage plan: settings,
# credentials, watch progress and cache all live here and survive updates.
StateDirectory=tvm
Environment=TVM_DATA_DIR=/var/lib/tvm

Restart=always
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
