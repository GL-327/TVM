#!/bin/sh
# Runs after packages are installed and the extra trees are copied in.
set -eu

mkosi-chroot systemctl enable tvm-core.service
mkosi-chroot systemctl enable tvm-session.service
mkosi-chroot systemctl set-default multi-user.target

# The kiosk owns tty1; a login prompt there would fight it for the display.
mkosi-chroot systemctl mask getty@tty1.service

# Belt and braces on top of the presets in mkosi.conf: nothing may ever hold
# the boot open waiting for a keyboard.
mkosi-chroot systemctl mask systemd-firstboot.service

chmod 0755 "$BUILDROOT/usr/lib/tvm/start-session.sh"
