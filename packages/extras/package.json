{
  "name": "@tvm/extras",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json && node sync-core.mjs",
    "prepare": "tsc -p tsconfig.json && node sync-core.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node sync-core.mjs --check",
    "test": "node sync-core.mjs --check && vitest run"
  },
  "devDependencies": { "vitest": "^4.1.10" }
}
