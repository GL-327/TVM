# Secrets — never commit credentials. .env.example must contain empty keys only.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
**/realdebridDefaultKey.ts

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-release/
build/
out/
*.tsbuildinfo

# Appliance images and boot artifacts
os/**/*.img
os/**/*.iso
os/**/*.raw
os/output/
os/staging/
os/mkosi.output/
os/mkosi.cache/

# Test and tooling output
coverage/
playwright-report/
test-results/

# Local runtime data
*.sqlite
*.sqlite-journal
*.log
logs/
cache/

# Roku sideload: machine-specific Core URL and zip
apps/roku/config.json
apps/roku/*.zip
Desktop/*.zip

# Local sideload binaries in Device Variations/ — keep the folder on disk, do not commit APK/IPA/zip
/Device Variations/*.apk
/Device Variations/*.ipa
/Device Variations/*.zip
/Device Variations/*.tar.gz
/Device Variations/*.sha256
/Device Variations/BUILD.txt

# Editor and OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated CocoaPods workspace
apps/ios/Pods/
apps/ios/TVM.xcworkspace/
