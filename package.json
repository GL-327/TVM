{
  "name": "tvm",
  "version": "1.4.10",
  "private": true,
  "description": "TVM - a remote-first TV media appliance",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "node scripts/launch-web.mjs",
    "dev:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-tvm.ps1",
    "dev:roku": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/roku-dev.ps1",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "check": "node scripts/check-changelog.mjs && node scripts/check-content.mjs && pnpm -r run typecheck && node apps/ios/check-project.mjs && node apps/android/check-project.mjs && node apps/roku/scripts/check.mjs",
    "roku:package": "node apps/roku/scripts/package.mjs",
    "fetch:packages": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-packages.ps1",
    "check:changelog": "node scripts/check-changelog.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
