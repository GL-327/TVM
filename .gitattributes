# The appliance is Linux. A CRLF ending on a shell script or a unit file breaks
# it at boot with "bad interpreter", so line endings are normalised everywhere
# rather than left to each developer's git config.
* text=auto eol=lf

*.sh          text eol=lf
*.service     text eol=lf
*.path        text eol=lf
*.conf        text eol=lf
mkosi.postinst text eol=lf
mkosi.prepare  text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.raw binary
*.img binary
