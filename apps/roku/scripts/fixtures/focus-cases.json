  "railViewFirst": [
    {
      "name": "scroll right past visible span",
      "count": 16,
      "focus": 11,
      "prevFirst": 0,
      "visible": 11,
      "expected": 1
    },
    {
      "name": "scroll right to last item",
      "count": 16,
      "focus": 15,
      "prevFirst": 0,
      "visible": 11,
      "expected": 5
    },
    {
      "name": "scroll left to focus",
      "count": 16,
      "focus": 3,
      "prevFirst": 5,
      "visible": 11,
      "expected": 3
    },
    {
      "name": "focus already visible, no scroll",
      "count": 16,
      "focus": 6,
      "prevFirst": 2,
      "visible": 11,
      "expected": 2
    },
    {
      "name": "clamp at end when no focus",
      "count": 16,
      "focus": -1,
      "prevFirst": 9,
      "visible": 11,
      "expected": 5
    },
    {
      "name": "count less than visible stays at 0",
      "count": 5,
      "focus": 3,
      "prevFirst": 2,
      "visible": 11,
      "expected": 0
    },
    {
      "name": "negative prevFirst clamps to 0",
      "count": 16,
      "focus": -1,
      "prevFirst": -4,
      "visible": 11,
      "expected": 0
    }
  ],
  "railWindow": [
    {
      "name": "start of rail includes left buffer when looping",
      "count": 16,
      "viewFirst": 0,
      "visible": 11,
      "buffer": 2,
      "expected": {
        "first": -2,
        "last": 12
      }
    },
    {
      "name": "middle of rail",
      "count": 40,
      "viewFirst": 5,
      "visible": 11,
      "buffer": 2,
      "expected": {
        "first": 3,
        "last": 17
      }
    },
    {
      "name": "end of rail includes right wrap buffer",
      "count": 16,
      "viewFirst": 5,
      "visible": 11,
      "buffer": 2,
      "expected": {
        "first": 3,
        "last": 17
      }
    },
    {
      "name": "buffer wraps below zero",
      "count": 40,
      "viewFirst": 1,
      "visible": 11,
      "buffer": 3,
      "expected": {
        "first": -2,
        "last": 14
      }
    },
    {
      "name": "buffer wraps past end",
      "count": 16,
      "viewFirst": 5,
      "visible": 11,
      "buffer": 4,
      "expected": {
        "first": 1,
        "last": 19
      }
    },
    {
      "name": "zero buffer in middle",
      "count": 40,
      "viewFirst": 5,
      "visible": 11,
      "buffer": 0,
      "expected": {
        "first": 5,
        "last": 15
      }
    },
    {
      "name": "count shorter than visible",
      "count": 5,
      "viewFirst": 0,
      "visible": 11,
      "buffer": 2,
      "expected": {
        "first": 0,
        "last": 4
      }
    },
    {
      "name": "empty rail",
      "count": 0,
      "viewFirst": 0,
      "visible": 11,
      "buffer": 2,
      "expected": {
        "first": 0,
        "last": -1
      }
    }
  ],
