{
  "parseFocusKey": [
    {
      "name": "empty key",
      "key": "",
      "expected": {
        "zone": "",
        "a": "",
        "b": ""
      }
    },
    {
      "name": "hero column",
      "key": "hero:1",
      "expected": {
        "zone": "hero",
        "a": "1",
        "b": ""
      }
    },
    {
      "name": "nav column",
      "key": "nav:6",
      "expected": {
        "zone": "nav",
        "a": "6",
        "b": ""
      }
    },
    {
      "name": "zone without colon",
      "key": "hero",
      "expected": {
        "zone": "hero",
        "a": "",
        "b": ""
      }
    },
    {
      "name": "plain rails item",
      "key": "rails:continue:itemA",
      "expected": {
        "zone": "rails",
        "a": "continue",
        "b": "itemA"
      }
    },
    {
      "name": "live item id keeps colons",
      "key": "rails:continue:live:abc:1",
      "expected": {
        "zone": "rails",
        "a": "continue",
        "b": "live:abc:1"
      }
    },
    {
      "name": "rd item id keeps colon",
      "key": "rails:continue:rd:tt123",
      "expected": {
        "zone": "rails",
        "a": "continue",
        "b": "rd:tt123"
      }
    },
    {
      "name": "rails key with no item",
      "key": "rails:continue",
      "expected": {
        "zone": "rails",
        "a": "continue",
        "b": ""
      }
    },
    {
      "name": "rails key with trailing colon",
      "key": "rails:continue:",
      "expected": {
        "zone": "rails",
        "a": "continue",
        "b": ""
      }
    }
  ],
  "sanitizeRailId": [
    {
      "name": "plain id",
      "railId": "continue",
      "expected": "continue"
    },
    {
      "name": "colon becomes underscore",
      "railId": "live:tv",
      "expected": "live_tv"
    },
    {
      "name": "several colons",
      "railId": "a:b:c",
      "expected": "a_b_c"
    },
    {
      "name": "empty",
      "railId": "",
      "expected": ""
    }
  ],
  "railFocusKey": [
    {
      "name": "plain",
      "railId": "continue",
      "itemId": "itemA",
      "expected": "rails:continue:itemA"
    },
    {
      "name": "rail id sanitised, item id keeps colons",
      "railId": "live:tv",
      "itemId": "live:abc:1",
      "expected": "rails:live_tv:live:abc:1"
    },
    {
      "name": "rd item id",
      "railId": "continue",
      "itemId": "rd:tt123",
      "expected": "rails:continue:rd:tt123"
    }
  ],
  "resolveRailFocus": [
    {
      "name": "item found in same rail",
      "rails": [
        {
          "id": "continue",
          "items": [
            {
              "id": "itemA"
            },
            {
              "id": "itemB"
            },
            {
              "id": "itemC"
            }
          ]
        },
        {
          "id": "trending",
          "items": [
            {
              "id": "t1"
            },
            {
              "id": "t2"
            }
          ]
        }
      ],
      "railId": "continue",
      "itemId": "itemC",
      "fallbackRow": 0,
      "fallbackCol": 0,
      "expected": {
        "row": 0,
        "col": 2,
        "found": true
      }
    },
    {
      "name": "continue reordered after playback, played item now index 0",
