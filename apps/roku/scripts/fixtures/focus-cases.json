  "railsSignature": {
    "cases": [
      {
        "name": "ids and progress",
        "rails": [
          {
            "id": "continue",
            "items": [
              {
                "id": "itemA",
                "progress": 0.5
              },
              {
                "id": "itemB"
              }
            ]
          }
        ],
        "expectedSignature": "|continue#itemA@50,itemB,"
      },
      {
        "name": "two rails",
        "rails": [
          {
            "id": "continue",
            "items": [
              {
                "id": "itemA",
                "progress": 0.5
              }
            ]
          },
          {
            "id": "trending",
            "items": [
              {
                "id": "t1"
              }
            ]
          }
        ],
        "expectedSignature": "|continue#itemA@50,|trending#t1,"
      },
      {
        "name": "progress 0 is kept, 1 is 100",
        "rails": [
          {
            "id": "x",
            "items": [
              {
                "id": "a",
                "progress": 1
              },
              {
                "id": "b",
                "progress": 0
              }
            ]
          }
        ],
        "expectedSignature": "|x#a@100,b@0,"
      }
    ],
