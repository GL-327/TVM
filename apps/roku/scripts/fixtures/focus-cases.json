        },
        {
          "id": "trending",
          "items": [
            {
              "id": "t1"
            },
            {
              "id": "t2"
            }
          ]
        }
      ],
      "railId": "continue",
      "itemId": "itemB",
      "fallbackRow": 0,
      "fallbackCol": 1,
      "expected": {
        "row": 0,
        "col": 0,
        "found": true
      }
    },
    {
      "name": "item vanished from rail, clamped fallback col in same rail",
