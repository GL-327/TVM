<?xml version="1.0" encoding="utf-8" ?>
<component name="PinPanel" extends="Group">
  <interface>
    <field id="heading" type="string" onChange="paint" />
    <field id="message" type="string" onChange="paint" />
    <field id="cooldown" type="integer" onChange="onCooldown" />
    <field id="wrong" type="boolean" alwaysNotify="true" onChange="onWrong" />
    <field id="action" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/intents.brs" />
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="PinPanel.brs" />
  <children>
    <Rectangle width="3840" height="2160" color="0x000000DD" />
    <Group id="panel" translation="[1120, 240]">
      <GlassPanel width="1600" height="1700" shape="panel" />
      <Label id="heading" translation="[100, 80]" width="1400" height="150" />
      <Label id="dots" translation="[100, 260]" width="1400" height="120" />
      <Label id="message" translation="[100, 390]" width="1400" height="180" wrap="true" />
      <Group id="keys" translation="[140, 620]" />
    </Group>
    <Timer id="tick" duration="1" repeat="true" />
    <Animation id="shake" duration="0.3">
      <Vector2DFieldInterpolator key="[0, 0.2, 0.4, 0.6, 0.8, 1]" keyValue="[[1120,240], [1096,240], [1144,240], [1108,240], [1132,240], [1120,240]]" fieldToInterp="panel.translation" />
    </Animation>
  </children>
</component>
