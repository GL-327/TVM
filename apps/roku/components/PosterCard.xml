<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterCard" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItem" />
    <field id="hasFocusStyle" type="boolean" onChange="onFocusStyle" />
    <field id="dimmed" type="boolean" onChange="onFocusStyle" />
    <field id="layout" type="string" value="portrait" onChange="onLayout" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="PosterCard.brs" />
  <children>
    <Group id="body">
      <Rectangle id="glow" color="0x00000000" cornerRadius="28" />
      <Rectangle id="ring" color="0x00000000" cornerRadius="24" />
      <Rectangle id="fill" color="0x161616FF" cornerRadius="20" />
      <MaskGroup id="mask">
        <Poster id="art" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Rectangle id="progressTrack" color="0x00000099" visible="false" />
      <Rectangle id="progressFill" color="0xE50914FF" visible="false" />
      <Label id="caption" color="0xF5F5F5FF" horizAlign="left" maxLines="1" />
      <Label id="yearLabel" color="0x8A8A8AFF" horizAlign="left" maxLines="1" />
    </Group>
    <Animation id="focusAnim" duration="0.2" easeFunction="outCubic" optional="true">
      <Vector2DFieldInterpolator id="scaleInterp" key="[0.0, 1.0]" keyValue="[[1.0, 1.0], [1.04, 1.04]]" fieldToInterp="body.scale" />
      <FloatFieldInterpolator id="opacityInterp" key="[0.0, 1.0]" keyValue="[1.0, 1.0]" fieldToInterp="body.opacity" />
    </Animation>
  </children>
</component>
