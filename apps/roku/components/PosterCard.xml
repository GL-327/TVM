<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterCard" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItem" />
    <field id="hasFocusStyle" type="boolean" onChange="onFocusStyle" />
    <field id="dimmed" type="boolean" onChange="onFocusStyle" />
    <field id="layout" type="string" value="portrait" onChange="onLayout" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="PosterCard.brs" />
  <children>
    <Group id="body">
      <Poster id="glow" uri="pkg:/images/glass/focus-glow.9.png" visible="false" />
      <Poster id="ring" uri="pkg:/images/glass/focus-ring.9.png" visible="false" />
      <Poster id="fill" uri="pkg:/images/glass/card-fill.9.png" blendColor="0x161D24FF" />
      <MaskGroup id="mask">
        <Poster id="art" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Poster id="badgeBg" uri="pkg:/images/glass/chip-fill.9.png" blendColor="0x12141AE6" visible="false" />
      <Label id="badgeText" color="0xF5F7FAFF" horizAlign="center" vertAlign="center" maxLines="1" visible="false" />
      <Poster id="progressTrack" uri="pkg:/images/glass/progress.9.png" blendColor="0xFFFFFF55" visible="false" />
      <Poster id="progressFill" uri="pkg:/images/glass/progress.9.png" blendColor="0xF5F5F5FF" visible="false" />
      <Label id="caption" color="0xF5F5F5FF" horizAlign="left" maxLines="1" visible="false" />
      <Label id="fallbackTitle" color="0xC4CCD5FF" horizAlign="center" vertAlign="center" wrap="true" maxLines="3" />
    </Group>
    <Animation id="focusAnim" duration="0.15" easeFunction="outCubic" optional="true">
      <Vector2DFieldInterpolator id="scaleInterp" key="[0.0, 1.0]" keyValue="[[1.0, 1.0], [1.04, 1.04]]" fieldToInterp="body.scale" />
      <Vector2DFieldInterpolator id="liftInterp" key="[0.0, 1.0]" keyValue="[[0.0, 0.0], [0.0, -12.0]]" fieldToInterp="body.translation" />
      <FloatFieldInterpolator id="opacityInterp" key="[0.0, 1.0]" keyValue="[1.0, 1.0]" fieldToInterp="body.opacity" />
      <Vector2DFieldInterpolator id="maskInterp" key="[0.0, 1.0]" fieldToInterp="mask.maskSize" />
    </Animation>
  </children>
</component>
