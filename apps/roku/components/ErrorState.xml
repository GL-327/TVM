<?xml version="1.0" encoding="utf-8" ?>
<component name="ErrorState" extends="Group">
  <interface>
    <field id="title" type="string" onChange="onTitle" />
    <field id="body" type="string" onChange="onBody" />
    <field id="hasFocusStyle" type="boolean" onChange="onFocusStyle" />
  </interface>
  <script type="text/brightscript" uri="ErrorState.brs" />
  <children>
    <Label id="kicker" text="Something went wrong" translation="[160, 0]" color="0x8A8A8AFF" font="font:SmallSystemFont" />
    <Label id="heading" translation="[160, 72]" width="2800" color="0xF5F5F5FF" font="font:LargeBoldSystemFont" />
    <Label id="lede" translation="[160, 220]" width="1800" wrap="true" maxLines="3" color="0xC4C4C4FF" font="font:MediumSystemFont" />
    <FocusButton id="retry" translation="[160, 460]" />
  </children>
</component>
