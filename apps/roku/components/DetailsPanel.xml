<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailsPanel" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItem" />
    <field id="children" type="array" onChange="onChildren" />
    <field id="saved" type="boolean" onChange="onSaved" />
    <field id="focusKey" type="string" />
    <field id="restoreKey" type="string" alwaysNotify="true" onChange="onRestoreKey" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="remoteIntent" type="string" alwaysNotify="true" onChange="onRemoteIntent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/intents.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/focus.brs" />
  <script type="text/brightscript" uri="DetailsPanel.brs" />
  <children>
    <Poster id="backdrop" width="3840" height="2160" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" />
    <Rectangle id="backdropFill" width="3840" height="2160" color="0x0B0B0BFF" visible="false" />
    <Poster id="vignetteLeft" width="2200" height="2160" uri="pkg:/images/chrome/details-vignette-left.png" />
    <Poster id="vignetteBottom" width="3840" height="840" translation="[0, 1320]" uri="pkg:/images/chrome/details-vignette-bottom.png" />
    <Label id="kicker" translation="[160, 360]" width="2400" height="60" color="0xC4C4C4FF" />
    <Label id="title" translation="[160, 430]" width="2400" height="260" wrap="true" maxLines="2" color="0xF5F5F5FF" />
    <Label id="imdb" translation="[160, 710]" width="440" height="64" color="0xF5C518FF" />
    <Label id="meta" translation="[600, 710]" width="2400" height="64" color="0xD8D9E8FF" />
    <FocusButton id="play" translation="[160, 830]" />
    <FocusButton id="imdbBtn" translation="[600, 830]" />
    <FocusButton id="save" translation="[1040, 830]" />
    <FocusButton id="back" translation="[1600, 830]" />
    <Label id="synopsis" translation="[160, 1030]" width="2400" height="260" wrap="true" maxLines="3" color="0xD8D9E8FF" />
    <Group id="picker" translation="[160, 1330]" />
  </children>
</component>
