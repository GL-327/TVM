      <Poster id="npFill" translation="[156, 690]" width="8" height="12" uri="pkg:/images/glass/progress.9.png" blendColor="0xF5F5F5FF" />
      <Label id="npPos" translation="[0, 664]" width="150" height="64" color="0xC4C4C4FF" />
      <Label id="npDur" translation="[788, 664]" width="180" height="64" horizAlign="right" color="0xC4C4C4FF" />
    </Group>
    <Group id="actions" translation="[56, 600]" />
    <Timer id="fbTimer" duration="5" repeat="false" />
  </children>
</component>
