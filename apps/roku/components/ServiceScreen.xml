<?xml version="1.0" encoding="utf-8" ?>
<component name="ServiceScreen" extends="Group">
  <interface>
    <field id="appId" type="string" />
    <field id="payload" type="assocarray" onChange="onPayload" />
    <field id="mode" type="string" value="loading" onChange="onMode" />
    <field id="action" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/intents.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="ServiceScreen.brs" />
  <children>
    <Rectangle id="bg" width="3840" height="2160" color="0x0B0B0BFF" />
    <Poster id="heroArt" width="3840" height="1120" loadDisplayMode="scaleToZoom" />
    <Poster width="3840" height="640" translation="[0, 480]" uri="pkg:/images/chrome/hero-vignette-bottom.png" />
    <Label id="kicker" translation="[160, 144]" color="0xC4C4C4FF" />
    <Label id="heading" translation="[160, 220]" width="2800" color="0xF5F5F5FF" />
    <Label id="disclaimer" translation="[160, 340]" width="2800" color="0x8A8A8AFF" />
    <FocusButton id="back" translation="[160, 460]" />
    <Group id="rails" translation="[0, 1120]" />
    <EmptyState id="empty" translation="[0, 1120]" />
    <Label id="loading" translation="[160, 640]" color="0xC4C4C4FF" text="Loading originals..." />
  </children>
</component>
