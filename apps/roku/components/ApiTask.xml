<?xml version="1.0" encoding="utf-8" ?>
<component name="ApiTask" extends="Task">
  <interface>
    <field id="requestUrl" type="string" />
    <field id="requestId" type="string" />
    <field id="requestMethod" type="string" value="GET" />
    <field id="requestBody" type="string" />
    <field id="profileId" type="string" />
    <field id="ok" type="boolean" />
    <field id="statusCode" type="integer" />
    <field id="json" type="assocarray" />
    <field id="error" type="string" />
    <field id="done" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="ApiTask.brs" />
</component>
