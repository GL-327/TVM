<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="releaseShortcut" type="boolean" value="false" />
    <field id="event" type="assocarray" onChange="onEvent" />
    <field id="appendPage" type="assocarray" alwaysNotify="true" onChange="onAppendPage" />
    <field id="mode" type="string" value="loading" onChange="onMode" />
    <field id="payload" type="assocarray" onChange="onPayload" />
    <field id="profileName" type="string" onChange="onProfileName" />
    <field id="errorTitle" type="string" />
    <field id="errorBody" type="string" />
    <field id="focusKey" type="string" />
    <field id="restoreKey" type="string" alwaysNotify="true" onChange="onRestoreKey" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="remoteIntent" type="string" alwaysNotify="true" onChange="onRemoteIntent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/intents.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/focus.brs" />
  <script type="text/brightscript" uri="HomeScreen.brs" />
  <children>
    <Poster id="heroFallback" width="3840" height="2160" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" />
    <Poster id="heroArt" width="3840" height="2160" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" />
    <Poster id="heroArtB" width="3840" height="2160" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" opacity="0" />
    <Poster id="heroVignetteLeft" width="2200" height="2160" uri="pkg:/images/chrome/hero-vignette-left.png" />
    <Poster id="heroVignetteBottom" width="3840" height="1100" translation="[0, 1060]" uri="pkg:/images/chrome/hero-vignette-bottom.png" />
    <Poster id="eventGlow" width="1800" height="1800" uri="pkg:/images/glass/orb-halo.png" translation="[-300, -100]" opacity="0.2" visible="false" />
    <Rectangle id="railScrim" width="3840" height="2160" color="0x000000B8" visible="false" />
    <Group id="heroCopy" translation="[160, 320]">
      <Poster id="eventLogo" width="1800" height="320" loadDisplayMode="scaleToFit" visible="false" />
      <Label id="eventLine" translation="[0, 420]" width="2400" height="140" wrap="true" maxLines="2" visible="false" />
      <Poster id="heroRatingBadge" translation="[1300, 340]" width="480" height="72" uri="pkg:/images/glass/chip-fill.9.png" blendColor="0xF5C518FF" visible="false" />
      <Label id="heroRating" translation="[1320, 344]" width="440" height="64" horizAlign="center" color="0x000000FF" />
      <Label id="heroTitle" width="2500" height="320" wrap="true" maxLines="2" vertAlign="bottom" color="0xF5F5F5FF" />
      <Label id="heroMeta" translation="[0, 344]" width="1200" height="64" color="0xD8D9E8FF" />
      <FocusButton id="playBtn" translation="[0, 456]" />
      <FocusButton id="detailsBtn" translation="[460, 456]" />
      <Group id="dots" translation="[0, 654]">
        <Poster id="dot0" uri="pkg:/images/glass/dot.png" width="16" height="16" blendColor="0xFFFFFFFF" />
        <Poster id="dot1" uri="pkg:/images/glass/dot.png" width="16" height="16" translation="[32, 0]" blendColor="0xFFFFFF59" />
        <Poster id="dot2" uri="pkg:/images/glass/dot.png" width="16" height="16" translation="[64, 0]" blendColor="0xFFFFFF59" />
        <Poster id="dot3" uri="pkg:/images/glass/dot.png" width="16" height="16" translation="[96, 0]" blendColor="0xFFFFFF59" />
      </Group>
    </Group>
    <Group id="rails" translation="[0, 1160]" />
    <NavStrip id="nav" translation="[0, 0]" />
    <Group id="status" translation="[0, 700]" visible="false">
      <ErrorState id="error" />
      <EmptyState id="empty" translation="[0, 0]" />
      <Label id="loading" text="Loading..." color="0xC4C4C4FF" translation="[160, 80]" />
    </Group>
    <Timer id="heroDebounce" duration="0.3" repeat="false" />
    <Timer id="heroTimer" duration="8" repeat="true" />
    <Animation id="heroFade" duration="0.55" easeFunction="inOutQuad" optional="true">
      <FloatFieldInterpolator id="heroFadeA" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="heroArt.opacity" />
      <FloatFieldInterpolator id="heroFadeB" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="heroArtB.opacity" />
    </Animation>
    <Animation id="railsAnim" duration="0.22" easeFunction="outCubic" optional="true">
      <Vector2DFieldInterpolator id="railsInterp" key="[0.0, 1.0]" keyValue="[[0.0, 1160.0], [0.0, 1160.0]]" fieldToInterp="rails.translation" />
    </Animation>
  </children>
</component>
