<?xml version="1.0" encoding="utf-8" ?>
<component name="ProfileOrb" extends="Group">
  <interface>
    <field id="avatar" type="string" onChange="paint" />
    <field id="locked" type="boolean" onChange="paint" />
    <field id="name" type="string" onChange="paint" />
    <field id="hue" type="integer" value="220" onChange="paint" />
    <field id="hasFocusStyle" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="ProfileOrb.brs" />
  <children>
    <Rectangle id="ring" width="336" height="336" translation="[-16, -16]" cornerRadius="36" color="0x00000000" />
    <Rectangle id="tile" width="304" height="304" cornerRadius="24" color="0x7C3AEDFF" />
    <Label id="initial" width="304" height="304" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
    <Poster id="avatar" width="304" height="304" loadWidth="304" loadHeight="304" loadDisplayMode="scaleToZoom" />
    <Label id="lock" translation="[16, 248]" width="272" height="52" text="Locked" color="0xFFFFFFFF" />
    <Label id="caption" translation="[0, 328]" width="304" horizAlign="center" color="0xC4C4C4FF" />
  </children>
</component>
