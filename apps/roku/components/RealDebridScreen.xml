    <FocusButton id="back" translation="[1700, 1240]" />
    <FocusButton id="overrideBtn" translation="[1120, 1416]" visible="false" />
    <FocusButton id="removeBtn" translation="[1700, 1416]" visible="false" />
  </children>
</component>
