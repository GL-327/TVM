      <Label id="reqWarn" translation="[1000, 980]" width="1800" height="140" wrap="true" maxLines="2" color="0xC4C4C4FF" />
      <FocusButton id="btnApprove" variant="glassPill" label="Approve" translation="[1000, 1260]" pillWidth="520" />
      <FocusButton id="btnDeny" variant="glassPill" label="Deny" translation="[1560, 1260]" pillWidth="520" />
