    <field id="phase" type="string" value="entry" onChange="paint" />
    <field id="message" type="string" onChange="paint" />
    <field id="request" type="assocarray" onChange="paint" />
    <field id="serverTime" type="string" />
    <field id="action" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/intents.brs" />
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="pkg:/source/hub.brs" />
  <script type="text/brightscript" uri="HubPair.brs" />
  <children>
    <Rectangle width="3840" height="2160" color="0x000000B3" />
    <GlassPanel id="glass" shape="panel" width="2320" height="1500" translation="[760, 330]" />
