<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="extrasPrefs" type="assocarray" onChange="paintSettings" />
    <field id="coreUrl" type="string" onChange="paintSettings" />
    <field id="health" type="assocarray" onChange="paintSettings" />
    <field id="themeId" type="string" onChange="paintSettings" />
    <field id="admin" type="boolean" onChange="paintSettings" />
    <field id="query" type="string" onChange="onSettingsQuery" />
    <field id="homeRows" type="array" onChange="paintSettings" />
    <field id="focusKey" type="string" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="remoteIntent" type="string" alwaysNotify="true" onChange="onRemoteIntent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/intents.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/media.brs" />
  <script type="text/brightscript" uri="SettingsScreen.brs" />
  <children>
    <Rectangle id="settingsBg" width="3840" height="2160" />
    <Group id="navigation" translation="[160, 100]" />
    <Group id="panel" translation="[1260, 136]" />
  </children>
</component>
