diff --git a/apps/ui/src/components/EventShelf.css b/apps/ui/src/components/EventShelf.css
new file mode 100644
index 0000000..051dcd4
--- /dev/null
+++ b/apps/ui/src/components/EventShelf.css
@@ -0,0 +1,96 @@
+/* A release event's row on Home. It lines up with every other row (same 20px gutter and spacing), carries a small
+   accent label above its title, a compact order switch on the title line, and a soft wash of the event's colours
+   that fades out on every side. */
+.home__shelf > .event-shelf {
+  position: relative;
+  isolation: isolate;
+  margin-top: 12px;
+  padding-top: 20px;
+}
+
+.event-shelf::before {
+  content: '';
+  position: absolute;
+  /* Starts at the row's own top edge: it never spreads up over the Live TV, Watchlist and Apps tiles. */
+  inset: 0 0 -16px;
+  z-index: -1;
+  pointer-events: none;
+  background: radial-gradient(85% 70% at 22% 45%, color-mix(in srgb, var(--event-glow) 22%, transparent), transparent 75%);
+  -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
+  mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
+}
+
+/* The row itself sits as Home's rows do (they get this as direct children of the shelf). */
+.event-shelf > .rail {
+  margin: 0 !important;
+  padding: 0 !important;
+  min-height: 0;
+}
+
+.event-shelf .rail__header {
+  display: flex !important;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin: 0 0 12px !important;
+  padding: 0 20px !important;
+}
+
+.event-shelf .rail__header .rail__title {
+  margin: 0 !important;
+}
+
+.event-shelf__kicker {
+  margin: 0 0 4px;
+  padding: 0 20px;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--event-accent);
+}
+
+.event-shelf__order {
+  display: inline-flex;
+  flex: none;
+  gap: 2px;
+  padding: 2px;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.1);
+}
+
+/* Compact, and the same colours whether or not it has focus (the default focus look turned the selected option
+   dark blue with dark text). */
+html body .event-shelf .event-shelf__chip,
+html body .event-shelf .event-shelf__chip[data-focused='true'] {
+  min-width: 0 !important;
+  min-height: 0 !important;
+  height: auto !important;
+  padding: 4px 10px !important;
+  border: 0 !important;
+  border-radius: 999px !important;
+  outline: none !important;
+  box-shadow: none !important;
+  transform: none !important;
+  background: transparent !important;
+  color: rgba(255, 255, 255, 0.78) !important;
+  font-size: 12px !important;
+  font-weight: 650 !important;
+  line-height: 1.2 !important;
+}
+
+html body .event-shelf .event-shelf__chip * {
+  color: inherit !important;
+  font: inherit !important;
+}
+
+html body .event-shelf .event-shelf__chip.event-shelf__chip--on,
+html body .event-shelf .event-shelf__chip.event-shelf__chip--on[data-focused='true'] {
+  background: var(--event-accent) !important;
+  color: #14100a !important;
+}
+
+html body .event-shelf .event-shelf__chip:not(.event-shelf__chip--on)[data-focused='true'] {
+  background: rgba(255, 255, 255, 0.14) !important;
+  color: #fff !important;
+}
diff --git a/apps/ui/src/components/EventShelf.tsx b/apps/ui/src/components/EventShelf.tsx
new file mode 100644
index 0000000..788a7ea
--- /dev/null
+++ b/apps/ui/src/components/EventShelf.tsx
@@ -0,0 +1,81 @@
+import { useEffect, useMemo, useState } from 'react';
+import { FocusButton } from './FocusButton';
+import { mapRailPosters } from './PosterCard';
+import { Rail } from './Rail';
+import { apiFetch, asTitle, type MediaItem } from '../data/media';
+import type { Title } from '../data/catalog';
+import './EventShelf.css';
+
+// Android: a big release (packages/content/events.json, e.g. The Hunger Games: Sunrise on the Reaping) gets its own
+// themed section on Home, in the event's colours, with its films in story order or release order.
+interface ActiveEvent {
+  id: string;
+  title: string;
+  line?: string;
+  kicker?: string;
+  accent?: string;
+  glow?: string;
+  rail?: { id?: string; title?: string };
+  items?: MediaItem[];
+}
+
+type Order = 'story' | 'release';
+
+export function EventShelf({ openTitle }: { openTitle: (title: Title) => void }): React.JSX.Element | null {
+  const [event, setEvent] = useState<ActiveEvent | null>(null);
+  const [order, setOrder] = useState<Order>('story');
+
+  useEffect(() => {
+    let alive = true;
+    apiFetch('/api/events/active')
+      .then((response) => (response.ok ? response.json() : null))
+      .then((body: { events?: ActiveEvent[] } | null) => {
+        if (alive) setEvent(body?.events?.find((entry) => (entry.items?.length ?? 0) > 0) ?? null);
+      })
+      .catch(() => undefined);
+    return () => { alive = false; };
+  }, []);
+
+  const titles = useMemo(() => {
+    // Every film in a saga starts with the same words, so the cut-off labels all read the same; the row shows the
+    // part that tells them apart ("Catching Fire", "Mockingjay Part 1"). The franchise is in the row's title.
+    const story = (event?.items ?? []).map(asTitle).map((title) => ({ ...title, title: shortName(title.title) }));
+    if (order === 'story') return story;
+    // Release order: by year, the story order breaking ties.
+    return story.map((title, index) => ({ title, index }))
+      .sort((a, b) => (a.title.year ?? 9999) - (b.title.year ?? 9999) || a.index - b.index)
+      .map((entry) => entry.title);
+  }, [event, order]);
+
+  if (event === null || titles.length === 0) return null;
+  const style = {
+    '--event-accent': event.accent ?? '#E8A33D',
+    '--event-glow': event.glow ?? event.accent ?? '#FF6A2A',
+  } as React.CSSProperties;
+  const name = (event.rail?.title ?? event.title).replace(/,\s*in story order$/i, '');
+  const toggle = (
+    <div className="event-shelf__order" role="group" aria-label="Order">
+      {(['story', 'release'] as const).map((value) => (
+        <FocusButton key={value} id={`event-order-${value}`}
+          className={`event-shelf__chip${order === value ? ' event-shelf__chip--on' : ''}`}
+          onSelect={() => setOrder(value)}>
+          {value === 'story' ? 'Story order' : 'Release order'}
+        </FocusButton>
+      ))}
+    </div>
+  );
+  return (
+    <section className="event-shelf" style={style} aria-label={event.title}>
+      {event.kicker !== undefined && event.kicker !== '' && <p className="event-shelf__kicker">{event.kicker}</p>}
+      <Rail id={event.rail?.id ?? `event-${event.id}`} title={name} action={toggle}>
+        {mapRailPosters(titles, `event-${event.id}-${order}`, openTitle)}
+      </Rail>
+    </section>
+  );
+}
+
+function shortName(name: string): string {
+  const parts = name.split(/:\s+/);
+  const rest = parts.length > 1 ? parts.slice(1).join(': ') : name;
+  return rest.replace(/^The Ballad of\s+/i, '').replace(/\s+-\s+Part\s+/i, ' Part ').trim() || name;
+}
