diff --git a/apps/ui/src/player/features/SleepAndStats.tsx b/apps/ui/src/player/features/SleepAndStats.tsx
new file mode 100644
index 0000000..542b5fd
--- /dev/null
+++ b/apps/ui/src/player/features/SleepAndStats.tsx
@@ -0,0 +1,90 @@
+import { useCallback, useEffect, useState } from 'react';
+import { FocusButton } from '../../components/FocusButton';
+import { requestFocus } from '../../nav/focusEngine';
+import { useScopedFocusKey } from '../../nav/ViewStackContext';
+import type { PlayerSession } from '../PlayerRoot';
+
+// Android only: the native player runs the sleep timer and draws the stats. These pickers are built exactly like
+// PlaybackSpeed (same classes, same menu) so the player looks as it always has; they only tell the native player.
+const COMMAND_EVENT = 'tvm:native-player-command';
+function sendNative(command: string, payload: Record<string, unknown> = {}): void {
+  window.dispatchEvent(new CustomEvent(COMMAND_EVENT, { detail: { command, payload } }));
+}
+
+type Option = { id: string; label: string };
+const SLEEP: Option[] = [
+  { id: 'off', label: 'Off' }, { id: '15', label: '15 minutes' }, { id: '30', label: '30 minutes' },
+  { id: '45', label: '45 minutes' }, { id: '60', label: '1 hour' }, { id: 'end', label: 'End of episode' },
+];
+const STATS: Option[] = [{ id: 'off', label: 'Hidden' }, { id: 'on', label: 'Shown' }];
+
+function Picker({ name, heading, options, value, label, onPick, controlsVisible, showControls }: {
+  name: string; heading: string; options: Option[]; value: string; label: string;
+  onPick: (id: string) => void; controlsVisible: boolean; showControls: () => void;
+}): React.JSX.Element {
+  const [open, setOpen] = useState(false);
+  const toggleKey = useScopedFocusKey(`player-${name}`);
+  const selectedKey = useScopedFocusKey(`player-${name}-${value}`);
+  const close = useCallback(() => { setOpen(false); requestFocus(toggleKey); }, [toggleKey]);
+  useEffect(() => { if (!controlsVisible) setOpen(false); }, [controlsVisible]);
+  useEffect(() => {
+    if (!open) return;
+    const frame = window.requestAnimationFrame(() => requestFocus(selectedKey));
+    const onKey = (event: KeyboardEvent): void => {
+      if (!['Escape', 'Backspace', 'BrowserBack', 'GoBack'].includes(event.key)) return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      close();
+    };
+    window.addEventListener('keydown', onKey, true);
+    return () => { window.cancelAnimationFrame(frame); window.removeEventListener('keydown', onKey, true); };
+  }, [close, open, selectedKey]);
+  return (
+    <div className="player-speed" data-player-feature={name}>
+      <FocusButton id={`player-${name}`} className="player-speed__toggle" disabled={!controlsVisible} onSelect={() => {
+        showControls();
+        if (open) close(); else setOpen(true);
+      }}>
+        <span aria-label={heading}>{label}</span>
+      </FocusButton>
+      {open && (
+        <div className="player-speed__menu" role="menu" aria-label={heading} data-player-menu={name} data-wrap="y"
+          onPointerDown={(event) => event.stopPropagation()}>
+          <p className="player-speed__heading">{heading}</p>
+          {options.map((option) => (
+            <FocusButton key={option.id} id={`player-${name}-${option.id}`} className="player-speed__option"
+              detail={value === option.id ? 'Selected' : undefined}
+              onSelect={() => { onPick(option.id); showControls(); close(); }}
+              onArrowPress={(direction) => {
+                if (direction === 'left' || direction === 'right') { close(); return false; }
+                return true;
+              }}>
+              {option.label}
+            </FocusButton>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+export function SleepTimerPicker({ engine, controlsVisible, showControls }: PlayerSession): React.JSX.Element | null {
+  const [choice, setChoice] = useState('off');
+  if (engine !== 'native') return null;
+  return (
+    <Picker name="sleep" heading="Sleep timer" options={SLEEP} value={choice}
+      label={choice === 'off' ? 'Sleep' : choice === 'end' ? 'Sleep: end' : `Sleep: ${choice}m`}
+      onPick={(id) => { setChoice(id); sendNative('sleepTimer', { choice: id }); }}
+      controlsVisible={controlsVisible} showControls={showControls} />
+  );
+}
+
+export function StatsPicker({ engine, controlsVisible, showControls }: PlayerSession): React.JSX.Element | null {
+  const [shown, setShown] = useState('off');
+  if (engine !== 'native') return null;
+  return (
+    <Picker name="stats" heading="Stats" options={STATS} value={shown} label="Stats"
+      onPick={(id) => { setShown(id); sendNative('stats', { visible: id === 'on' }); }}
+      controlsVisible={controlsVisible} showControls={showControls} />
+  );
+}
