<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVM" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/tvm_bg</item>
        <item name="android:navigationBarColor">@color/tvm_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@color/tvm_bg</item>
        <item name="android:colorBackground">@color/tvm_bg</item>
        <item name="colorPrimary">@color/tvm_accent</item>
        <item name="colorOnPrimary">@color/tvm_ink</item>
        <item name="colorSecondary">@color/tvm_accent</item>
        <item name="android:textColor">@color/tvm_text</item>
        <item name="android:textColorPrimary">@color/tvm_text</item>
        <item name="checkboxStyle">@style/Widget.TVM.CheckBox</item>
    </style>
    <style name="Widget.TVM.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/tvm_accent</item>
    </style>
</resources>
