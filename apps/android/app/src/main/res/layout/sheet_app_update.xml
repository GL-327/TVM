<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → App & Updates: one sheet for checking, offering, downloading and installing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/sheet_grip" />

    <ImageView
        android:id="@+id/update_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/update_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/tvm_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/update_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/tvm_sheet_muted"
        android:textSize="14.5sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/update_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:visibility="gone"
        app:indicatorColor="@color/tvm_blue"
        app:trackColor="@color/tvm_sheet_track"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/tvm_sheet_muted"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_primary"
        style="@style/Widget.TVM.Button.Sheet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_secondary"
        style="@style/Widget.TVM.Button.SheetQuiet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp" />
</LinearLayout>
