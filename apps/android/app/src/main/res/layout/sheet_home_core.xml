<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors OptionalHomeCoreSheet in TVMApp.swift. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tvm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_core_title"
                android:textColor="@color/tvm_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/close"
                style="@style/Widget.TVM.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_core_lede"
            android:textColor="@color/tvm_muted" />

        <TextView
            style="@style/TextAppearance.TVM.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/host_address" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints=""
            android:background="@drawable/field"
            android:hint="@string/address_hint"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/tvm_text"
            android:textColorHint="@color/tvm_muted" />

        <TextView
            style="@style/TextAppearance.TVM.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/lan_token" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints=""
            android:background="@drawable/field"
            android:hint="@string/token_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/tvm_text"
            android:textColorHint="@color/tvm_muted" />

        <CheckBox
            android:id="@+id/allow_http"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/allow_http"
            android:textColor="@color/tvm_text" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tvm_warning"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/connecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/tvm_text"
            android:visibility="gone" />

        <Button
            android:id="@+id/connect"
            style="@style/Widget.TVM.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/connect" />
    </LinearLayout>
</ScrollView>
