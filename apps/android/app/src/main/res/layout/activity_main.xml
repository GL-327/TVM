<?xml version="1.0" encoding="utf-8"?>
<!--
  Mirrors the iOS PlayerShell: the interface fills the screen edge to edge,
  a quiet menu floats top right, and loading and errors are drawn over black.
  Safe areas are the page's business, published to it as window.__tvmDevice.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tvm_bg">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible" />

    <ProgressBar
        android:id="@+id/starting"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/tvm_text" />

    <LinearLayout
        android:id="@+id/error_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tvm_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/app_name"
            android:textColor="@color/tvm_text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/error_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/tvm_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/error_reload"
            style="@style/Widget.TVM.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="48dp"
            android:text="@string/reload_short" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/page_loading"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:indeterminateTint="@color/tvm_text"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/menu_button"
            android:contentDescription="@string/settings"
            android:focusable="false"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</FrameLayout>
